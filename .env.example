# Database
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5434/nexus

# Cache
REDIS_URL=redis://localhost:6379/0

# LLM provider (Qwen Cloud OpenAI-compatible API)
QWEN_CLOUD_API_KEY=your-qwen-cloud-api-key-here
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Models
# NOTE: T1 embeddings currently run locally via T1_MODEL (sentence-transformers);
# EMBEDDING_MODEL is reserved for a future Qwen-embedding tier and is not yet read.
EMBEDDING_MODEL=text-embedding-v4
T1_MODEL=BAAI/bge-small-en-v1.5
T2_MODEL=qwen3.6-flash
T3_MODEL=qwen3.7-max

# Application
APP_SECRET=your-app-secret-here
